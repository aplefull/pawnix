rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /rooms/{roomId} {
      function uid() {
        return request.auth.uid;
      }

      function changedKeys() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }

      function isSeated(players) {
        return uid() in players.values();
      }

      function isFull(players) {
        return !(null in players.values());
      }

      function occupiedCount(players) {
        return players.values().removeAll([null]).size();
      }

      function seatsOf(game) {
        return game in ['quoridor', 'word-pairs'] ? ['One', 'Two'] : [];
      }

      function hasSeats(value, seats) {
        return value is map && value.keys().hasOnly(seats) && value.keys().hasAll(seats);
      }

      function isName(name) {
        return name is string && name.size() > 0 && name.size() <= 20 && name == name.trim();
      }

      function isSeatNamed(data, seat) {
        return data.players[seat] == null ? data.names[seat] == null : isName(data.names[seat]);
      }

      function hasNamedSeats(data) {
        let seats = seatsOf(data.game);

        return seats.size() == 2
          && hasSeats(data.players, seats)
          && hasSeats(data.names, seats)
          && isSeatNamed(data, seats[0])
          && isSeatNamed(data, seats[1]);
      }

      function isNewGame(data) {
        return (data.game == 'quoridor' && quoridorIsNewRoom(data))
          || (data.game == 'word-pairs' && wordPairsIsInitial(data.state));
      }

      function isGameUpdate(players, before, after) {
        let game = resource.data.game;

        return (game == 'quoridor' && quoridorIsUpdate(players, before, after))
          || (game == 'word-pairs' && wordPairsIsUpdate(players, before, after));
      }

      function canReadSecret(room, secret) {
        return room.game == 'word-pairs' && wordPairsCanReadSecret(room.state, secret);
      }

      function isSecretWrite(room, seat, secret) {
        return room.game == 'word-pairs' && wordPairsIsSecretWrite(room, seat, secret);
      }

      function isValidNewRoom() {
        let data = request.resource.data;

        return roomId.matches('^[A-HJKMNP-Z2-9]{6}$')
          && data.keys().hasOnly(['game', 'players', 'names', 'state', 'createdAt', 'expiresAt'])
          && data.createdAt == request.time
          && data.expiresAt is timestamp
          && data.expiresAt > request.time
          && data.expiresAt < request.time + duration.value(8, 'd')
          && hasNamedSeats(data)
          && data.players.values().removeAll([null]) == [uid()]
          && isNewGame(data);
      }

      function isClaimingSeat() {
        let before = resource.data.players;
        let after = request.resource.data.players;
        let seats = after.diff(before);

        return changedKeys().hasOnly(['players', 'names'])
          && !isSeated(before)
          && seats.addedKeys().size() == 0
          && seats.removedKeys().size() == 0
          && seats.changedKeys().size() == 1
          && after.values().removeAll(before.values()) == [uid()]
          && occupiedCount(after) == occupiedCount(before) + 1
          && request.resource.data.names.diff(resource.data.names).affectedKeys() == seats.affectedKeys()
          && hasNamedSeats(request.resource.data);
      }

      function isUpdatingState() {
        let players = resource.data.players;

        return changedKeys().hasOnly(['state'])
          && isSeated(players)
          && isFull(players)
          && isGameUpdate(players, resource.data.state, request.resource.data.state);
      }

      function quoridorInitialState() {
        return {
          'walls': [],
          'playerOnePos': { 'row': 16, 'col': 8 },
          'playerTwoPos': { 'row': 0, 'col': 8 },
          'playerOneWallsLeft': 10,
          'playerTwoWallsLeft': 10,
          'turn': 'One',
          'winner': null
        };
      }

      function quoridorIsInitial(state) {
        return state == quoridorInitialState();
      }

      function quoridorIsNewRoom(data) {
        return quoridorIsInitial(data.state);
      }

      function quoridorOpponentOf(seat) {
        return seat == 'One' ? 'Two' : 'One';
      }

      function quoridorPosKey(seat) {
        return seat == 'One' ? 'playerOnePos' : 'playerTwoPos';
      }

      function quoridorWallsLeftKey(seat) {
        return seat == 'One' ? 'playerOneWallsLeft' : 'playerTwoWallsLeft';
      }

      function quoridorIsTile(pos) {
        return pos is map
          && pos.keys().hasOnly(['row', 'col'])
          && pos.row is int && pos.col is int
          && pos.row >= 0 && pos.row <= 16 && pos.col >= 0 && pos.col <= 16
          && pos.row % 2 == 0 && pos.col % 2 == 0;
      }

      function quoridorIsWall(wall) {
        return wall is map
          && wall.keys().hasOnly(['row', 'col', 'orientation'])
          && wall.row is int && wall.col is int
          && wall.row >= 1 && wall.row <= 15 && wall.col >= 1 && wall.col <= 15
          && wall.row % 2 == 1 && wall.col % 2 == 1
          && wall.orientation in ['horizontal', 'vertical'];
      }

      function quoridorIsMove(seat, before, after) {
        let current = before[quoridorPosKey(seat)];
        let next = after[quoridorPosKey(seat)];
        let goalRow = seat == 'One' ? 0 : 16;

        return after.diff(before).affectedKeys().hasOnly([quoridorPosKey(seat), 'turn', 'winner'])
          && quoridorIsTile(next)
          && (math.abs(next.row - current.row) + math.abs(next.col - current.col)) in [2, 4]
          && next != after[quoridorPosKey(quoridorOpponentOf(seat))]
          && after.winner == (next.row == goalRow ? seat : null);
      }

      function quoridorIsPlace(seat, before, after) {
        let count = before.walls.size();
        let key = quoridorWallsLeftKey(seat);

        return after.diff(before).affectedKeys().hasOnly(['walls', key, 'turn'])
          && after[key] == before[key] - 1
          && after[key] >= 0
          && after.walls.size() == count + 1
          && (count == 0 || after.walls[0:count] == before.walls)
          && quoridorIsWall(after.walls[count]);
      }

      function quoridorIsTurn(players, before, after) {
        let seat = before.turn;

        return players[seat] == uid()
          && before.winner == null
          && after.turn == quoridorOpponentOf(seat)
          && (quoridorIsMove(seat, before, after) || quoridorIsPlace(seat, before, after));
      }

      function quoridorIsRestart(before, after) {
        return before.winner != null && quoridorIsInitial(after);
      }

      function quoridorIsUpdate(players, before, after) {
        return quoridorIsTurn(players, before, after) || quoridorIsRestart(before, after);
      }

      function wordPairsStateKeys() {
        return ['language', 'totalRounds', 'round', 'phase', 'matcher', 'nouns', 'adjectives', 'guess', 'scores'];
      }

      function wordPairsGuesser(state) {
        return state.matcher == 'One' ? 'Two' : 'One';
      }

      function wordPairsIsWords(words) {
        return words is list && words.size() == 5 && words.toSet().size() == 5;
      }

      function wordPairsIsPairing(pairing) {
        return pairing is list && pairing.size() == 5 && pairing.toSet() == [0, 1, 2, 3, 4].toSet();
      }

      function wordPairsIsInitial(state) {
        return state.keys().hasOnly(wordPairsStateKeys())
          && state.keys().hasAll(wordPairsStateKeys())
          && state.language in ['ru', 'en']
          && state.totalRounds in [2, 4, 6, 8, 10]
          && state.round == 1
          && state.phase == 'matching'
          && state.matcher == 'One'
          && wordPairsIsWords(state.nouns)
          && wordPairsIsWords(state.adjectives)
          && state.guess == null
          && state.scores == { 'One': 0, 'Two': 0 };
      }

      function wordPairsIsSubmittingPairing(players, before, after) {
        let secret = getAfter(/databases/$(database)/documents/rooms/$(roomId)/private/$(before.matcher));

        return before.phase == 'matching'
          && players[before.matcher] == uid()
          && after.diff(before).affectedKeys().hasOnly(['phase'])
          && after.phase == 'guessing'
          && secret != null
          && secret.data.round == before.round;
      }

      function wordPairsIsGuessing(players, before, after) {
        return before.phase == 'guessing'
          && players[wordPairsGuesser(before)] == uid()
          && after.diff(before).affectedKeys().hasOnly(['phase', 'guess'])
          && after.phase == 'reveal'
          && wordPairsIsPairing(after.guess);
      }

      function wordPairsIsScored(before, after) {
        let guesser = wordPairsGuesser(before);

        return after.scores.keys().hasOnly(['One', 'Two'])
          && after.scores[before.matcher] == before.scores[before.matcher]
          && after.scores[guesser] >= before.scores[guesser]
          && after.scores[guesser] <= before.scores[guesser] + 5;
      }

      function wordPairsIsNextRound(before, after) {
        return before.phase == 'reveal'
          && before.round < before.totalRounds
          && after.diff(before).affectedKeys().hasOnly(['phase', 'round', 'matcher', 'nouns', 'adjectives', 'guess', 'scores'])
          && after.phase == 'matching'
          && after.round == before.round + 1
          && after.matcher == wordPairsGuesser(before)
          && wordPairsIsWords(after.nouns)
          && wordPairsIsWords(after.adjectives)
          && after.guess == null
          && wordPairsIsScored(before, after);
      }

      function wordPairsIsFinishing(before, after) {
        return before.phase == 'reveal'
          && before.round == before.totalRounds
          && after.diff(before).affectedKeys().hasOnly(['phase', 'scores'])
          && after.phase == 'finished'
          && wordPairsIsScored(before, after);
      }

      function wordPairsIsRematch(before, after) {
        return before.phase == 'finished'
          && wordPairsIsInitial(after)
          && after.language == before.language
          && after.totalRounds == before.totalRounds;
      }

      function wordPairsIsUpdate(players, before, after) {
        return wordPairsIsSubmittingPairing(players, before, after)
          || wordPairsIsGuessing(players, before, after)
          || wordPairsIsNextRound(before, after)
          || wordPairsIsFinishing(before, after)
          || wordPairsIsRematch(before, after);
      }

      function wordPairsCanReadSecret(state, secret) {
        return secret.round < state.round
          || (secret.round == state.round && state.phase in ['reveal', 'finished']);
      }

      function wordPairsIsSecretWrite(room, seat, secret) {
        return isFull(room.players)
          && room.state.phase == 'matching'
          && room.state.matcher == seat
          && secret.keys().hasOnly(['round', 'pairing'])
          && secret.keys().hasAll(['round', 'pairing'])
          && secret.round == room.state.round
          && wordPairsIsPairing(secret.pairing);
      }

      allow get: if request.auth != null;
      allow create: if request.auth != null && isValidNewRoom();
      allow update: if request.auth != null && (isClaimingSeat() || isUpdatingState());

      match /private/{seat} {
        function room() {
          return get(/databases/$(database)/documents/rooms/$(roomId)).data;
        }

        function canGetSecret() {
          let current = room();

          return current.players[seat] == uid() || (isSeated(current.players) && canReadSecret(current, resource.data));
        }

        function canWriteSecret() {
          let current = room();

          return current.players[seat] == uid() && isSecretWrite(current, seat, request.resource.data);
        }

        allow get: if request.auth != null && canGetSecret();
        allow create, update: if request.auth != null && canWriteSecret();
      }
    }
  }
}
