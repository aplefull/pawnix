{
  "name": "quoridor",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "clsx": "^2.1.1",
    "firebase": "^13.1.0",
    "ngraph.graph": "^20.1.2",
    "ngraph.path": "^1.6.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.5",
    "zustand": "^5.0.16"
  },
  "scripts": {
    "dev": "vite",
    "dev:emulators": "firebase emulators:exec --only firestore,auth --project demo-quoridor \"vite --mode emulators\"",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "biome lint",
    "format": "biome format --write",
    "check": "biome check --write",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tests/tsconfig.json",
    "test": "firebase emulators:exec --only firestore --project demo-quoridor \"vitest run --no-file-parallelism\""
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "sass": "^1.107.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "type": "module"
}
