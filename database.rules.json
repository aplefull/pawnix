{
  "rules": {
    "rooms": {
      "$roomId": {
        ".read": "auth != null",
        "presence": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && $roomId.matches(/^[A-HJKMNP-Z2-9]{6}$/)",
            ".validate": "newData.isNumber() && newData.val() <= now"
          }
        },
        "live": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && $roomId.matches(/^[A-HJKMNP-Z2-9]{6}$/)",
            ".validate": "newData.hasChildren(['round', 'phase', 'picks'])",
            "round": {
              ".validate": "newData.isNumber()"
            },
            "phase": {
              ".validate": "newData.isString() && newData.val().length <= 20"
            },
            "picks": {
              ".validate": "newData.isString() && newData.val().matches(/^[0-9*-]{1,20}$/)"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    }
  }
}
